{
  "name": "winglet/core",
  "description": "Winglet Core Framework",
  "type": "library",
  "license": "proprietary",
  "keywords": [
    "framework",
    "rest",
    "doctrine",
    "jwt",
    "middleware",
    "php",
    "winglet"
  ],
  "homepage": "https://bitbucket.org/winglet/core",
  "authors": [
    {
      "name": "Winglet",
      "role": "Framework"
    }
  ],
  "require": {
    "php": ">=8.5 <8.6",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "doctrine/orm": "^3.6",
    "monolog/monolog": "^3.10",
    "psr/cache": "^3.0",
    "psr/container": "^2.0",
    "psr/log": "^3.0",
    "psr/simple-cache": "^3.0",
    "symfony/cache": "^7.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12.5",
    "rector/rector": "^2.5",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Winglet\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Winglet\\Core\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.5.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "phpstan": "php -d memory_limit=1G vendor/bin/phpstan analyse -c phpstan.neon.dist",
    "phpunit": "php vendor/bin/phpunit -c phpunit.xml.dist --display-all-issues",
    "test": [
      "@phpstan",
      "@phpunit"
    ],
    "validate-container": "php bin/console validate:container --include-routes --include-probes"
  },
  "bin": [
    "bin/build-controllers-and-routes",
    "bin/console",
    "bin/doctrine"
  ]
}
